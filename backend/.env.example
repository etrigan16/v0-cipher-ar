# Required — the backend refuses to boot without these
SECRET_KEY=generate-a-random-secret-key-here
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=contact@example.com

# Optional — defaults apply when unset
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aukalabs
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional — LLM enrichment (Phase 4). OpenAI-compatible client pointed at Groq
# (ADR-005). Without LLM_API_KEY, enrichment falls back to deterministic
# templates and the scan pipeline never depends on an external LLM.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=30
